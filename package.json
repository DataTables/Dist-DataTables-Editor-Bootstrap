{
    "name": "datatables.net-editor-bs",
    "description": "Editor for DataTables with styling for [Bootstrap](https://getbootstrap.com/docs/3.3/)",
    "main": "./js/editor.bootstrap.js",
    "module": "./js/editor.bootstrap.mjs",
    "style": "./css/editor.bootstrap.css",
    "types": "./types/editor.bootstrap.d.ts",
    "version": "3.1.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Editing",
        "CRUD",
        "Inline",
        "Modal",
        "Multi-row",
        "Bootstrap",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-editor": "3.1.1",
        "datatables.net-bs": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/editor.bootstrap.d.ts",
            "style": "./css/editor.bootstrap.css",
            "import": "./js/editor.bootstrap.mjs",
            "require": "./js/editor.bootstrap.js",
            "default": "./js/editor.bootstrap.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/editor.bootstrap.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}